---
/** Starburst punctuation — the pink/blue shapes in the reference. */
interface Props { tone?: "hot" | "cold" | "acid"; size?: number; spin?: boolean; class?: string; }
const { tone = "hot", size = 64, spin = true, class: extra = "" } = Astro.props;
const pts = Array.from({ length: 24 }, (_, i) => {
  const a = (i / 24) * Math.PI * 2;
  const r = i % 2 === 0 ? 50 : 26;
  return `${50 + r * Math.cos(a)},${50 + r * Math.sin(a)}`;
}).join(" ");
---
<svg
  class:list={["burst", `t-${tone}`, spin && "spin", extra]}
  viewBox="0 0 100 100" width={size} height={size} aria-hidden="true"
>
  <polygon points={pts} />
</svg>

<style>
  .burst { position: absolute; pointer-events: none; }
  .t-hot  polygon { fill: var(--hot); }
  .t-cold polygon { fill: var(--cold); }
  .t-acid polygon { fill: var(--acid); }
  .spin { animation: spin 18s linear infinite; transform-origin: 50% 50%; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .spin { animation: none; } }
</style>
