---
// Real lines from people Shrey has worked with. Text, never client logos —
// a logo wall mixing real employers with spec brands implies relationships
// that do not exist, and body-copy disclosure never undoes a one-glance read.
const quotes = [
  "What an absolute gem to work with",
  "Love your attention to detail",
  "A work friend we do not deserve, but need",
  "You sure AI didn't help you?",
  "My go-to person for AI, pop culture or ranting",
  "Love your third eye",
];
---

<section class="ticker on-dark" aria-label="What the experts say">
  <div class="ticker-rail">
    <ul class="ticker-track">
      {quotes.map((q) => (
        <li><span class="q">&ldquo;{q}&rdquo;</span><span class="star" aria-hidden="true">✳</span></li>
      ))}
    </ul>
    <ul class="ticker-track" aria-hidden="true">
      {quotes.map((q) => (
        <li><span class="q">&ldquo;{q}&rdquo;</span><span class="star">✳</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .ticker {
    background: var(--ink);
    color: var(--on-ink);
    padding-block: var(--s-3);
    overflow: hidden;
  }
  .ticker-rail {
    display: flex;
    width: max-content;
    animation: slide 46s linear infinite;
  }
  .ticker:hover .ticker-rail { animation-play-state: paused; }

  .ticker-track { display: flex; align-items: center; }
  .ticker-track li { display: flex; align-items: center; }

  .q {
    font-family: var(--display);
    font-style: italic;
    font-size: clamp(1.1rem, 2.4vw, 2rem);
    white-space: nowrap;
  }
  .star {
    color: var(--gold);
    margin-inline: clamp(1.5rem, 4vw, 3.5rem);
    font-size: 0.85em;
  }

  @keyframes slide {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }

  /* Freeze, never remove — the content still has to be readable. */
  @media (prefers-reduced-motion: reduce) {
    .ticker-rail { animation: none; }
    .ticker { overflow-x: auto; }
  }
</style>
