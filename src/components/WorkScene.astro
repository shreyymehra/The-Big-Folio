---
interface Props {
  index: number;
  title: string;
  subject: string;
  teaser: string;
  lead: string;
  support?: string;
  kind: "spec" | "real";
  status: "published" | "in-development";
  tone: "light" | "dark";
  accent?: string;
}
const { index, title, subject, teaser, lead, support, kind, status, tone, accent } = Astro.props;

const live = status === "published";
const num = String(index).padStart(2, "0");
---

<article
  class:list={["scene", "work-scene", tone === "dark" && "on-dark"]}
  style={accent ? `--scene-accent:${accent}` : undefined}
>
  <div class="shell">
    <div class="work-head">
      <span class="label">{num}</span>
      <span class="label work-subject">{subject}</span>
      {kind === "real" && <span class="badge badge-real">Shipped</span>}
      {!live && <span class="badge">In development</span>}
    </div>

    <h3 class="display work-title" data-rise>
      <span class="wipe"><span>{title}</span></span>
    </h3>

    <div class="work-body">
      <p class="lede work-teaser" data-rise style="--rise-delay:120ms">{teaser}</p>

      <div class="work-side" data-rise style="--rise-delay:220ms">
        <p class="label">
          {lead}{support && <> <span aria-hidden="true">·</span> {support}</>}
        </p>
        {live ? (
          <span class="work-open">
            <span>Read the case</span>
            <span class="open-line" aria-hidden="true"></span>
          </span>
        ) : (
          <span class="label work-pending">Written next</span>
        )}
      </div>
    </div>
  </div>
</article>

<style>
  .work-scene {
    padding-block: var(--scene-y);
    border-top: 1px solid var(--rule);
  }

  .work-head {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    flex-wrap: wrap;
    margin-bottom: var(--s-3);
  }
  .work-subject { color: var(--text-mid); }

  .badge {
    font-family: var(--label);
    font-size: 0.62rem;
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    padding: 0.28rem 0.6rem;
    border: 1px dashed var(--rule);
    border-radius: 999px;
    color: var(--text-low);
  }
  .badge-real {
    border-style: solid;
    border-color: var(--gold);
    color: var(--gold);
  }

  .work-title {
    font-size: var(--t-huge);
    max-width: 18ch;
  }
  .work-scene:hover .work-title { color: var(--scene-accent, var(--text)); }
  .work-title { transition: color var(--d-mid) var(--ease-out); }

  .work-body {
    margin-top: var(--s-4);
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--s-4);
    align-items: start;
  }
  .work-teaser { max-width: 40ch; }

  .work-side { display: flex; flex-direction: column; gap: var(--s-2); }

  .work-open {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--label);
    font-size: var(--t-label);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    min-height: 44px;
  }
  .open-line {
    width: clamp(2rem, 5vw, 4.5rem);
    height: 1px;
    background: currentColor;
    transform-origin: left;
    transition: transform var(--d-mid) var(--ease-out);
  }
  .work-scene:hover .open-line { transform: scaleX(1.5); }

  .work-pending { color: var(--text-low); }

  @media (max-width: 720px) {
    .work-body { grid-template-columns: 1fr; gap: var(--s-3); }
    .work-title { max-width: 100%; }
  }
</style>
