---
const links = [
  { href: "#work", text: "Work" },
  { href: "#process", text: "Process" },
  { href: "#about", text: "About" },
];
---

<header class="nav">
  <a class="mark" href="#top" aria-label="Shrey Mehra — top">
    <span class="mark-glyph" aria-hidden="true">SM</span>
    <span class="mark-word">Shrey Mehra</span>
  </a>

  <nav class="links" aria-label="Sections">
    {links.map((l) => <a href={l.href}>{l.text}</a>)}
  </nav>

  <a class="cta" href="#contact">
    <span>Contact</span>
    <span class="cta-dot" aria-hidden="true">→</span>
  </a>
</header>

<style>
  .nav {
    position: fixed;
    top: var(--s-2);
    left: 50%;
    transform: translateX(-50%);
    z-index: var(--z-nav);

    width: calc(100% - (var(--gutter) * 0.9));
    max-width: var(--max);

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);

    padding: 0.55rem 0.55rem 0.55rem 1rem;
    border: 1px solid rgba(18, 16, 14, 0.1);
    border-radius: 999px;
    background: rgba(239, 235, 227, 0.72);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
  }

  /* --- mark --- */
  .mark { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 44px; }
  .mark-glyph {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.02em;
    width: 2rem; height: 2rem;
    display: grid; place-items: center;
    border: 1px solid var(--gold);
    border-radius: 50%;
    color: var(--on-bone);
    transition: transform var(--d-fast) var(--ease-out), background var(--d-fast) var(--ease-out);
  }
  .mark:hover .mark-glyph { transform: rotate(-12deg); background: var(--gold); }
  .mark-word {
    font-family: var(--label);
    font-size: var(--t-label);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
  }

  /* --- links --- */
  .links { display: flex; gap: var(--s-3); }
  .links a {
    font-family: var(--label);
    font-size: var(--t-label);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    color: var(--on-bone-mid);
    padding: 0.4rem 0;
    position: relative;
    transition: color var(--d-fast) var(--ease-out);
  }
  .links a::after {
    content: "";
    position: absolute;
    left: 0; bottom: 0;
    width: 100%; height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--d-fast) var(--ease-out);
  }
  .links a:hover { color: var(--on-bone); }
  .links a:hover::after { transform: scaleX(1); transform-origin: left; }

  /* --- cta: button-in-button --- */
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.4rem 0 1.1rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bone);
    font-family: var(--label);
    font-size: var(--t-label);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    transition: background var(--d-fast) var(--ease-out), transform var(--d-fast) var(--ease-out);
  }
  .cta-dot {
    width: 1.9rem; height: 1.9rem;
    display: grid; place-items: center;
    border-radius: 50%;
    background: rgba(239, 235, 227, 0.14);
    transition: transform var(--d-fast) var(--ease-out), background var(--d-fast) var(--ease-out);
  }
  .cta:hover { background: var(--flare); }
  .cta:hover .cta-dot { transform: translate(2px, -1px) scale(1.06); background: rgba(239, 235, 227, 0.24); }
  .cta:active { transform: scale(0.98); }

  /* Links fold away before they can crowd. The mark and one action survive —
     v3 shipped five links that overflowed a 375px viewport by 95px. */
  @media (max-width: 860px) {
    .links { display: none; }
  }
  @media (max-width: 460px) {
    .mark-word { display: none; }
    .nav { padding-left: 0.55rem; }
  }
</style>
