---
import CutWord from "./CutWord.astro";
import Burst from "./Burst.astro";

/** Domains being targeted — the "editorial blobs". */
const domains = ["Brand", "Creative Strategy", "Communications", "PR", "GTM"];
---

<section class="hero" aria-label="Introduction">
  <p class="sr-only">
    Hi, my name is Shrey and I wanted to do this since I was eight.
  </p>

  <div class="stage">
    <!-- the photograph -->
    <figure class="photo" data-depth="0.12">
      <img
        src="/img/shrey-8.jpg"
        alt="Shrey Mehra as a child"
        width="720" height="900"
        onerror="this.closest('.photo').classList.add('is-empty')"
      />
      <figcaption class="photo-slot micro">
        drop <code>shrey-8.jpg</code> into <code>/public/img/</code>
      </figcaption>
    </figure>

    <!-- the cut-out sentence -->
    <div class="note" aria-hidden="true">
      <span class="ln ln-1">
        <CutWord cut={2} rotate={-3} depth={0.5} tone="paper">Hi!</CutWord>
        <CutWord cut={3} rotate={2}  depth={0.34} size="sm">my</CutWord>
        <CutWord cut={4} rotate={-1} depth={0.42} size="sm">name</CutWord>
        <CutWord cut={3} rotate={3}  depth={0.3}  size="sm">is</CutWord>
      </span>

      <span class="ln ln-2">
        <CutWord cut={1} rotate={-2} depth={0.62} tone="paper">Shrey</CutWord>
      </span>

      <span class="ln ln-3">
        <CutWord cut={4} rotate={2}  depth={0.28} size="sm">and I wanted</CutWord>
        <CutWord cut={3} rotate={-2} depth={0.36} size="sm">to do this</CutWord>
      </span>

      <span class="ln ln-4">
        <CutWord cut={5} rotate={-1} depth={0.7} tone="acid">since I was 8</CutWord>
      </span>

      <Burst tone="hot"  size={92} class="b b-1" />
      <Burst tone="cold" size={64} class="b b-2" />
    </div>

    <!-- domains being targeted -->
    <ul class="domains" data-depth="0.2">
      {domains.map((d) => <li class="blob">{d}</li>)}
    </ul>

    <p class="cue micro">Keep scrolling <span aria-hidden="true">&darr;</span></p>
  </div>
</section>

<style>
  .hero { position: relative; height: 220vh; background: var(--void); }

  .stage {
    position: sticky; top: 0;
    height: 100svh;
    display: grid;
    place-items: center;
    overflow: clip;
    /* 0 → 1 across the scroll of .hero, set by script */
    --p: 0;
  }

  /* --- photograph --- */
  .photo {
    position: relative;
    width: clamp(13rem, 26vw, 22rem);
    aspect-ratio: 4 / 5;
    transform:
      translate3d(0, calc(var(--p) * -14vh), 0)
      scale(calc(1 + var(--p) * 0.16));
    filter: saturate(calc(1 - var(--p) * 0.7)) brightness(calc(1 - var(--p) * 0.35));
    transition: filter var(--d-fast) linear;
  }
  .photo img {
    width: 100%; height: 100%;
    object-fit: cover;
    border: 6px solid var(--paper);
    box-shadow: 0 18px 50px rgba(0,0,0,.55);
  }
  .photo-slot { display: none; }
  .photo.is-empty img { display: none; }
  .photo.is-empty {
    display: grid; place-items: center;
    border: 2px dashed rgba(251,249,244,.3);
    border-radius: 3px;
    color: var(--text-mid);
  }
  .photo.is-empty .photo-slot { display: block; text-align: center; padding: var(--s-2); }
  .photo code { color: var(--acid); font-family: var(--label); }

  /* --- the note --- */
  .note {
    position: absolute; inset: 0;
    display: grid; align-content: center; justify-items: center;
    gap: clamp(.4rem, 1.4vh, 1rem);
    padding-inline: var(--gutter);
    pointer-events: none;
  }
  .ln { display: flex; flex-wrap: wrap; gap: .4rem; align-items: baseline; justify-content: center; }
  .ln-1 { transform: translate3d(-14%, -4vh, 0); }
  .ln-2 { transform: translate3d(28%, -1vh, 0); }
  .ln-3 { transform: translate3d(-22%, 5vh, 0); }
  .ln-4 { transform: translate3d(18%, 9vh, 0); }

  .b { z-index: -1; }
  .b-1 { top: 16%; right: 18%; }
  .b-2 { bottom: 22%; left: 14%; }

  /* --- domains --- */
  .domains {
    position: absolute;
    bottom: clamp(4.5rem, 11vh, 8rem);
    display: flex; flex-wrap: wrap; gap: .5rem; justify-content: center;
    padding-inline: var(--gutter);
    opacity: calc(1 - var(--p) * 1.6);
  }
  .blob {
    font-family: var(--cut-3);
    font-size: var(--t-micro);
    text-transform: uppercase;
    letter-spacing: .14em;
    padding: .42em .9em;
    border: 1px solid rgba(251,249,244,.28);
    border-radius: 999px;
    color: var(--text-mid);
  }

  .cue {
    position: absolute;
    bottom: clamp(1.2rem, 4vh, 2.5rem);
    color: var(--text-mid);
    opacity: calc(1 - var(--p) * 2);
  }

  @media (max-width: 720px) {
    .ln-1, .ln-2, .ln-3, .ln-4 { transform: none; }
    .note { gap: .5rem; }
    .b-1 { top: 8%; right: 4%; }
    .b-2 { bottom: 26%; left: 2%; }
  }
</style>

<script>
  // One rAF-throttled scroll read drives every depth layer through --p.
  const hero = document.querySelector<HTMLElement>(".hero");
  const stage = hero?.querySelector<HTMLElement>(".stage");

  if (hero && stage && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const layers = [...hero.querySelectorAll<HTMLElement>("[data-depth]")];
    let ticking = false;

    const update = () => {
      ticking = false;
      const r = hero.getBoundingClientRect();
      const span = r.height - window.innerHeight;
      const p = span > 0 ? Math.min(1, Math.max(0, -r.top / span)) : 0;
      stage.style.setProperty("--p", p.toFixed(4));
      for (const el of layers) {
        const d = parseFloat(el.dataset.depth || "0");
        el.style.setProperty("--py", (p * d * -180).toFixed(1) + "px");
      }
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll, { passive: true });
    update();
  }
</script>
