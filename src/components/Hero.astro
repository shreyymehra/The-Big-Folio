---
import CutWord from "./CutWord.astro";
import Burst from "./Burst.astro";

const domains = ["Brand", "Creative Strategy", "Communications", "PR", "GTM"];
---

<section class="hero" aria-label="Introduction">
  <p class="sr-only">
    Hi, my name is Shrey and I wanted to do this since I was eight.
  </p>

  <div class="stage">
    <div class="frame">

      <!-- Placement is by GRID AREA, not transform offsets, so the
           composition genuinely re-lays-out per breakpoint instead of
           scaling one fixed arrangement. -->

      <span class="ln ln-1" aria-hidden="true">
        <CutWord cut={2} rotate={-3} depth={0.55}>Hi!</CutWord>
        <CutWord cut={3} rotate={2}  depth={0.38} size="sm">my</CutWord>
        <CutWord cut={4} rotate={-1} depth={0.46} size="sm">name</CutWord>
        <CutWord cut={3} rotate={3}  depth={0.32} size="sm">is</CutWord>
      </span>

      <span class="ln ln-2" aria-hidden="true">
        <CutWord cut={1} rotate={-2} depth={0.72}>Shrey</CutWord>
      </span>

      <figure class="photo" data-depth="0.14">
        <img
          src="/img/shrey-8.jpg"
          alt="Shrey Mehra as a child"
          width="720" height="900"
          onerror="this.closest('.photo').classList.add('is-empty')"
        />
        <figcaption class="photo-slot micro">
          drop <code>shrey-8.jpg</code><br />into <code>/public/img/</code>
        </figcaption>
      </figure>

      <span class="ln ln-3" aria-hidden="true">
        <CutWord cut={4} rotate={2}  depth={0.3} size="sm">and I wanted</CutWord>
        <CutWord cut={3} rotate={-2} depth={0.4} size="sm">to do this</CutWord>
      </span>

      <span class="ln ln-4" aria-hidden="true">
        <CutWord cut={5} rotate={-1} depth={0.85} tone="acid">since I was 8</CutWord>
      </span>

      <ul class="domains" data-depth="0.22">
        {domains.map((d) => <li class="blob">{d}</li>)}
      </ul>

      <Burst tone="hot"  size={104} class="b b-1" />
      <Burst tone="cold" size={72}  class="b b-2" />

      <p class="cue micro">Keep scrolling <span aria-hidden="true">&darr;</span></p>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; height: 240svh; background: var(--void); }

  .stage {
    position: sticky; top: 0;
    height: 100svh;
    overflow: clip;
    --p: 0;
  }

  /* The editorial frame: a real 12x10 grid filling the viewport, capped
     at --max and gutter-padded. Every element claims grid area, so a
     wide screen gets a wide composition rather than a centred huddle. */
  .frame {
    position: relative;
    width: 100%; height: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding: clamp(1rem, 3.5vh, 3rem) var(--gutter);
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: repeat(10, 1fr);
    align-items: center;
  }

  .ln { display: flex; flex-wrap: wrap; gap: .4rem; align-items: baseline; }

  /* --- desktop composition: spread across the whole frame --- */
  .ln-1 { grid-area: 2 / 1 / 3 / 7;  justify-self: start; }
  .ln-2 { grid-area: 3 / 2 / 5 / 8;  justify-self: start; z-index: 3; }
  .photo { grid-area: 2 / 7 / 8 / 12; justify-self: center; align-self: center; }
  .ln-3 { grid-area: 6 / 1 / 7 / 6;  justify-self: start; }
  .ln-4 { grid-area: 7 / 3 / 9 / 10; justify-self: start; z-index: 3; }
  .domains { grid-area: 10 / 1 / 11 / 10; align-self: end; }
  .cue { grid-area: 10 / 10 / 11 / 13; justify-self: end; align-self: end; }

  /* --- photograph --- */
  .photo {
    position: relative;
    width: min(100%, 24rem);
    aspect-ratio: 4 / 5;
    transform:
      translate3d(0, calc(var(--p) * -12svh), 0)
      scale(calc(1 + var(--p) * 0.14));
    filter: saturate(calc(1 - var(--p) * .7)) brightness(calc(1 - var(--p) * .35));
    transition: filter var(--d-fast) linear;
  }
  .photo img {
    width: 100%; height: 100%;
    object-fit: cover;
    border: 6px solid var(--paper);
    box-shadow: 0 18px 60px rgba(0,0,0,.6);
  }
  .photo-slot { display: none; }
  .photo.is-empty img { display: none; }
  .photo.is-empty {
    display: grid; place-items: center;
    border: 2px dashed rgba(251,249,244,.28);
    border-radius: 3px;
    color: var(--text-mid);
  }
  .photo.is-empty .photo-slot { display: block; text-align: center; line-height: 1.9; }
  .photo code { color: var(--acid); font-family: var(--label); }

  /* --- bursts pinned to frame corners, not to the type --- */
  .b { z-index: 1; }
  .b-1 { top: 8%;  right: 6%; }
  .b-2 { bottom: 14%; left: 4%; }

  /* --- domains --- */
  .domains {
    display: flex; flex-wrap: wrap; gap: .5rem;
    opacity: calc(1 - var(--p) * 1.6);
  }
  .blob {
    font-family: var(--cut-3);
    font-size: var(--t-micro);
    text-transform: uppercase;
    letter-spacing: .14em;
    padding: .42em .9em;
    border: 1px solid rgba(251,249,244,.26);
    border-radius: 999px;
    color: var(--text-mid);
    white-space: nowrap;
  }

  .cue { color: var(--text-mid); opacity: calc(1 - var(--p) * 2); white-space: nowrap; }

  /* --- tablet: photo drops behind, type takes the width --- */
  @media (max-width: 1080px) {
    .ln-1 { grid-area: 2 / 1 / 3 / 9; }
    .ln-2 { grid-area: 3 / 1 / 5 / 10; }
    .photo { grid-area: 4 / 7 / 9 / 13; width: min(100%, 19rem); }
    .ln-3 { grid-area: 6 / 1 / 7 / 7; }
    .ln-4 { grid-area: 7 / 1 / 9 / 9; }
    .domains { grid-area: 10 / 1 / 11 / 13; }
    .cue { display: none; }
  }

  /* --- mobile: a single readable column, no overlap at all --- */
  @media (max-width: 760px) {
    .frame {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      grid-auto-rows: min-content;
      align-content: center;
      gap: clamp(.5rem, 1.6vh, 1.1rem);
      padding-block: clamp(3rem, 9vh, 5rem);
    }
    .ln-1, .ln-2, .photo, .ln-3, .ln-4, .domains {
      grid-area: auto; justify-self: start; width: auto;
    }
    .photo { justify-self: center; width: min(58%, 13rem); }
    .ln-2, .ln-4 { justify-self: start; }
    .domains { justify-self: start; margin-top: var(--s-2); }
    .b-1 { top: 3%; right: 2%; }
    .b-2 { bottom: 6%; left: 1%; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>(".hero");
  const stage = hero?.querySelector<HTMLElement>(".stage");

  if (hero && stage && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const layers = [...hero.querySelectorAll<HTMLElement>("[data-depth]")];
    let ticking = false;

    const update = () => {
      ticking = false;
      const r = hero.getBoundingClientRect();
      const span = r.height - window.innerHeight;
      const p = span > 0 ? Math.min(1, Math.max(0, -r.top / span)) : 0;
      stage.style.setProperty("--p", p.toFixed(4));
      for (const el of layers) {
        const d = parseFloat(el.dataset.depth || "0");
        el.style.setProperty("--py", (p * d * -190).toFixed(1) + "px");
      }
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll, { passive: true });
    update();
  }
</script>
