---
/**
 * One word, cut out and stuck down.
 * The mismatch between families IS the effect — cut={1..5} picks a
 * different typeface per word. Never unify them.
 */
interface Props {
  cut?: 1 | 2 | 3 | 4 | 5;
  rotate?: number;      // degrees; keep small, these are stuck by hand
  size?: "lg" | "sm";
  tone?: "paper" | "hot" | "cold" | "acid" | "ink";
  depth?: number;       // parallax strength, 0 = pinned
  class?: string;
}
const {
  cut = 1, rotate = 0, size = "lg", tone = "paper", depth = 0,
  class: extra = "",
} = Astro.props;
---

<span
  class:list={["cut", `cut-${cut}`, `sz-${size}`, `tone-${tone}`, extra]}
  style={`--rot:${rotate}deg; --depth:${depth};`}
  data-depth={depth || undefined}
>
  <slot />
</span>

<style>
  .cut {
    display: inline-block;
    padding: var(--label-pad-y) var(--label-pad-x);
    background: var(--label-bg);
    color: var(--label-ink);
    border-radius: var(--label-radius);
    box-shadow: var(--label-shadow);
    line-height: 1.06;
    white-space: nowrap;
    transform: rotate(var(--rot)) translate3d(0, var(--py, 0px), 0);
    will-change: transform;
  }

  /* the five cuts */
  .cut-1 { font-family: var(--cut-1); font-weight: 600; font-style: italic; }
  .cut-2 { font-family: var(--cut-2); font-weight: 400; text-transform: uppercase; letter-spacing: -.01em; }
  .cut-3 { font-family: var(--cut-3); font-weight: 700; }
  .cut-4 { font-family: var(--cut-4); font-weight: 500; }
  .cut-5 { font-family: var(--cut-5); font-weight: 400; text-transform: uppercase; letter-spacing: .04em; }

  .sz-lg { font-size: var(--t-cut); }
  .sz-sm { font-size: var(--t-cut-s); }

  .tone-hot   { background: var(--hot);   color: var(--paper); }
  .tone-cold  { background: var(--cold);  color: var(--paper); }
  .tone-acid  { background: var(--acid);  color: var(--ink); }
  .tone-ink   { background: var(--ink);   color: var(--paper); }
</style>
