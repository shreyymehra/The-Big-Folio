---
/**
 * Rolling jackpot loader. Three reels spin, stagger-stop onto the three
 * domains, flash a win, then the curtain lifts.
 *
 * Hard rules:
 *  - never longer than ~2.2s, and skippable at any moment
 *  - shows once per session, not on every navigation
 *  - reduced-motion skips straight to the revealed state
 *  - inert to the keyboard so it can never trap focus
 */
const reels = [
  ["Brand", "Culture", "Comms", "Strategy", "PR", "GTM", "Brand"],
  ["Culture", "Comms", "Copy", "Launch", "Brand", "Story", "Culture"],
  ["Comms", "GTM", "Brand", "Creative", "Culture", "Voice", "Comms"],
];
---

<div class="loader" id="loader" aria-hidden="true">
  <div class="machine">
    <p class="micro machine-top">Insert curiosity</p>

    <div class="reels">
      {reels.map((strip, i) => (
        <div class="reel" data-reel={i}>
          <div class="strip" style={`--n:${strip.length}`}>
            {strip.map((w) => <span class="slot">{w}</span>)}
          </div>
        </div>
      ))}
    </div>

    <p class="micro machine-foot"><span class="win-word">Jackpot</span></p>
  </div>

  <button class="skip micro" type="button" data-skip>Skip &rarr;</button>
</div>

<style>
  .loader {
    position: fixed; inset: 0; z-index: var(--z-loader);
    display: grid; place-items: center;
    background: var(--void);
    transition: transform var(--d-slow) var(--ease-out),
                opacity var(--d-mid) linear;
  }
  .loader.is-done { transform: translate3d(0, -100%, 0); opacity: 0; pointer-events: none; }

  .machine { text-align: center; padding-inline: var(--gutter); }
  .machine-top { color: var(--text-mid); margin-bottom: var(--s-2); }
  .machine-foot { margin-top: var(--s-2); color: transparent; }

  .reels {
    display: flex; gap: .4rem; justify-content: center;
    padding: .6rem;
    border: 2px solid rgba(251,249,244,.16);
    border-radius: 4px;
    background: rgba(251,249,244,.04);
  }

  .reel {
    --h: clamp(2.6rem, 7vw, 4.6rem);
    height: var(--h);
    width: clamp(6.2rem, 20vw, 12rem);
    overflow: hidden;
    background: var(--paper);
    border-radius: 2px;
    box-shadow: inset 0 0 0 2px rgba(0,0,0,.1);
  }

  .strip {
    display: flex; flex-direction: column;
    animation: roll .42s linear infinite;
  }
  .slot {
    height: var(--h);
    display: grid; place-items: center;
    font-family: var(--cut-2);
    font-size: clamp(.95rem, 2.6vw, 1.9rem);
    text-transform: uppercase;
    color: var(--ink);
    letter-spacing: -.01em;
  }

  @keyframes roll {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(0, calc(var(--h) * -1), 0); }
  }

  /* stagger-stop: each reel halts on its first face */
  .reel.is-stopped .strip { animation: none; transform: translate3d(0,0,0); }
  .reel.is-stopped { animation: thunk .26s var(--ease-snap); }
  @keyframes thunk {
    0% { transform: translateY(-5px); }
    60% { transform: translateY(2px); }
    100% { transform: translateY(0); }
  }

  .loader.is-win .reel { box-shadow: inset 0 0 0 2px var(--acid), 0 0 0 3px var(--acid); }
  .loader.is-win .win-word {
    color: var(--acid);
    animation: blink .18s steps(2) 4;
  }
  @keyframes blink { 50% { opacity: 0; } }

  .skip {
    position: absolute; right: var(--gutter); bottom: var(--gutter);
    color: var(--text-mid);
    min-height: 44px; padding-inline: .6rem;
  }
  .skip:hover { color: var(--paper); }

  @media (prefers-reduced-motion: reduce) {
    .strip { animation: none; }
    .reel.is-stopped { animation: none; }
    .loader.is-win .win-word { animation: none; }
  }
</style>

<script>
  const loader = document.getElementById("loader");
  if (loader) {
    const reels = [...loader.querySelectorAll<HTMLElement>(".reel")];
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const seen = sessionStorage.getItem("folio-loader") === "1";
    let closed = false;

    const finish = () => {
      if (closed) return;
      closed = true;
      loader.classList.add("is-done");
      document.body.style.removeProperty("overflow");
      sessionStorage.setItem("folio-loader", "1");
      window.setTimeout(() => loader.remove(), 950);
    };

    if (seen || reduced) {
      finish();
    } else {
      document.body.style.overflow = "hidden";
      reels.forEach((r, i) => {
        window.setTimeout(() => r.classList.add("is-stopped"), 620 + i * 300);
      });
      window.setTimeout(() => loader.classList.add("is-win"), 1320);
      window.setTimeout(finish, 2150);
    }

    loader.querySelector("[data-skip]")?.addEventListener("click", finish);
    window.addEventListener("keydown", (e) => { if (e.key === "Escape") finish(); });
  }
</script>
